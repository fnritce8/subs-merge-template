   "*.local",
   "*.msftconnecttest.com",
   "*.msftncsi.com",
   "localhost.ptlogin2.qq.com",
   "time.*.com",
   "ntp.*.com",
   "+.pool.ntp.org"
  ],
  "default-nameserver": [
   "223.5.5.5",
   "119.29.29.29"
  ],
  "nameserver": [
   "https://dns.alidns.com/dns-query",
   "https://doh.pub/dns-query"
  ],
  "proxy-server-nameserver": [
   "https://dns.alidns.com/dns-query",
   "https://doh.pub/dns-query"
  ]
